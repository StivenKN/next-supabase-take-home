# Copy to .env.local, or run `pnpm setup:env`, which writes .env.local for you.
# Values come from `pnpm exec supabase status -o env`, under different names:

# API_URL
NEXT_PUBLIC_SUPABASE_URL=
# PUBLISHABLE_KEY (ANON_KEY on older Supabase CLIs)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET_KEY
SUPABASE_SECRET_KEY=
