{
  "private": true,
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev": "concurrently -n supabase,next -c cyan,magenta \"pnpm dev:supabase\" \"pnpm dev:next\"",
    "dev:next": "next dev",
    "dev:supabase": "supabase start",
    "setup:env": "bash scripts/setup-env.sh",
    "db:load": "bash scripts/load-coffee-health.sh",
    "db:reset": "supabase db reset && pnpm db:load",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0 && pnpm lint:boundary",
    "lint:boundary": "eslint -c eslint.boundary.config.mjs --no-inline-config --quiet .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsc-rs --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "verify:pagination": "vitest run --config vitest.verify.config.mts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run",
    "prepare": "simple-git-hooks",
    "evals:exercise": "node evals/exercise/run.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "latest",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/eslint-plugin": "1.6.28",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "fast-check": "4.10.2",
    "jsdom": "^29.1.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.79.0",
    "postcss": "^8",
    "simple-git-hooks": "2.14.0",
    "supabase": "^2.101.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsc-rs": "0.8.0",
    "typescript": "^5",
    "typescript-eslint": "8.72.1",
    "vitest": "^4.1.7"
  },
  "simple-git-hooks": {
    "preserveUnused": true,
    "pre-commit": "[ -x node_modules/.bin/lint-staged ] && grep -q '\"lint-staged\"' package.json || exit 0; node_modules/.bin/lint-staged --no-stash --no-hide-partially-staged --quiet"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "eslint -c eslint.boundary.config.mjs --no-inline-config --quiet --no-warn-ignored"
    ]
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
