{
  // `tsc` only type-checks here; Next.js compiles with SWC. These options decide
  // what `pnpm typecheck` (and CI) reject, so they are tuned to catch the bugs
  // that slip through review: unchecked array/record reads, silent fallthrough,
  // and APIs the supported browsers don't have.
  "compilerOptions": {
    // Next.js's default browser floor is Chrome/Edge/Firefox 111 and Safari 16.4,
    // which covers ES2023 but not ES2024 (Object.groupBy, Promise.withResolvers).
    // "esnext" here would let code type-check and then throw in those browsers.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2023"],
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": true,

    // Modules: settings Next.js requires, plus `verbatimModuleSyntax`, which
    // makes type-only imports say `import type` so it is clear which imports
    // disappear at build time.
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",

    // Type safety beyond `strict`.
    "strict": true,
    // `rows[i]` and `record[key]` are `T | undefined` until checked.
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    // Side-effect imports like `import "./setup"` must resolve. (`*.css` is
    // declared by Next.js, so stylesheet paths are not checked.)
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,

    // Print whole types in errors so the fix is visible from the CLI output
    // alone, without opening an editor.
    "noErrorTruncation": true,

    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
