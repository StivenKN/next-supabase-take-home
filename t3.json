{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup",
      "command": "pnpm bootstrap --skip-supabase-without-docker",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Dev",
      "command": "pnpm dev",
      "icon": "play",
      "stopOnSettle": true
    },
    {
      "name": "Check",
      "command": "pnpm check",
      "icon": "lint"
    },
    {
      "name": "Test",
      "command": "pnpm test",
      "icon": "test",
      "stopOnSettle": true
    }
  ]
}
